  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "****************************************\n\r\nWITH ALL MY LOVE\r\n\uB2F9\uC2E0\uC744
    \uC704\uD55C \uC774\uC57C\uAE30\r\n\r\n****************************************\n\r\n\r\nCREATED
    BY\n[\uC11C\uC0C1\uD6C8]\r\n\r\n\r\nINSPIRED BY\n[\uC5FC\uB780\uC601]\r\n\n\nCHARACTER\n[\uC5FC\uB780\uC601]\n\r\n\r\nSPECIAL
    THANKS TO\r\n\uC6B0\uB9AC\uAC00 \uD568\uAED8\uD55C \uBAA8\uB4E0 \uC21C\uAC04\uB4E4\uC5D0\uAC8C\r\n\r\n\r\n****************************************\n\r\n\r\n\uC774
    \uAC8C\uC784\uC758 \uBAA8\uB4E0 \uC21C\uAC04\uC740\r\n\uB2F9\uC2E0\uC744 \uC704\uD574
    \uB9CC\uB4E4\uC5B4\uC84C\uC2B5\uB2C8\uB2E4\n\r\n\r\n****************************************\n\r\n\r\nDEVELOPMENT\r\n   
    \r\nGame Design & Programming\r\n[\uC11C\uC0C1\uD6C8]\n\r\nArt & Graphics\n[\uC11C\uC0C1\uD6C8]\r\n\r\nStory
    & Narrative\n[\uC11C\uC0C1\uD6C8]\n\n\r\n\r\n****************************************\n\r\n\r\nTHANK
    YOU FOR PLAYING\r\n\r\n\uC774 \uAC8C\uC784\uC744 \uB05D\uAE4C\uC9C0 \uD50C\uB808\uC774\uD574\uC900\r\n\uC138\uC0C1\uC5D0\uC11C
    \uAC00\uC7A5 \uC18C\uC911\uD55C \uB2F9\uC2E0\uC5D0\uAC8C\r\n\r\n\r\n****************************************\n\r\n\r\n2026
    - FOREVER\r\nMade with \u2661 for you\r\n\r\uC0DD\uC77C \uCD95\uD558\uD574~\n\r\n****************************************"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 9b85a0cd656836c42b569f00ff6cabeb, type: 2}
  m_sharedMaterial: {fileID: 3840218210516997188, guid: 9b85a0cd656836c42b569f00ff6cabeb, type: 2}
