    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[13].text
      value: "\uB0B4 \uC606\uC5D0 \uC788\uC5B4\uC904\uAC70\uC9C0?"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[14].text
      value: "\uACE0\uB9C8"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[15].text
      value: "\uADF8\uB7F0\uB370 \uCE74\uCE04\uB3C4 \uC606\uC5D0\uC11C \uCF00\uC774\uD06C
        \uB3C4\uC640\uC92C\uC5B4!"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[16].text
      value: "\uD2B9\uBCC4\uCD9C\uC5F0\n\nPatissier\r\n[\uD53C\uCE74\uCE04]"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[17].text
      value: "\uADF8\uB7F0\uB370 \uC788\uC796\uC544."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[18].text
      value: "\uC0C1\uD6C8\uC774\uAC00 \uC5B4\uB514\uC5D0\r\n\uAC07\uD600\uC788\uC5C8\uB294\uC9C0
        \uB208\uCE58\uCC58\uC5B4?\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[19].text
      value: "\uC0AC\uC2E4\uC740 \uB124 \uB9C8\uC74C \uC18D\uC774\uC5C8\uC5B4.\r\n\uAC70\uAE30\uC11C
        \uAF3C\uC9DD\uB3C4 \uBABB\uD558\uACE0 \uC788\uAC70\uB4E0.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[20].text
      value: "\uADF8\uB798\uC11C \uB538\uAE30\uB3C4 \uBAA8\uC544\uB2EC\uB77C\uD558\uACE0\r\n\uB2EC\uAC40\uB3C4
        \uAD6C\uD574\uB2EC\uB77C\uD558\uACE0\r\n\uBC00\uAC00\uB8E8\uB3C4 \uB0A0\uB77C\uB2EC\uB77C\uD55C\uAC70\uC57C.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[21].text
      value: "\uACB0\uAD6D\uC5D4 \uB2E4 \uD574\uC92C\uB124, \uC5ED\uC2DC\r\n\uACE0\uB9C8\uC6CC,
        \uB780\uC601\uC544.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[22].text
      value: "\uCF00\uC774\uD06C\uBCF4\uB2E4 \uB124\uAC00 \uB354 \uB2EC\uC544."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[23].text
      value: "\uC0DD\uC77C \uCD95\uD558\uD574.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[24].text
      value: "\uC774 \uAC8C\uC784\uC744 \uB05D\uAE4C\uC9C0 \uD50C\uB808\uC774\uD574\uC900\r\n\uC138\uC0C1\uC5D0\uC11C
        \uAC00\uC7A5 \uC18C\uC911\uD55C \uB2F9\uC2E0\uC5D0\uAC8C"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[25].text
      value: "\uC0AC\uB791\uD574.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[26].text
