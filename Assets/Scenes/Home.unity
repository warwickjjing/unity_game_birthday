    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[0].text
      value: "\u2661 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        \u2661\n\r\nWITH ALL MY LOVE\r\n\uB2F9\uC2E0\uC744 \uC704\uD55C \uC774\uC57C\uAE30\r\n\r\n\u2661
        \u2500\u2500\u2500\u2500\u2500\u2500THE END\u2500\u2500\u2500\u2500\u2500\u2500
        \u2661"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[1].text
      value: "CREATED BY\n[\uC11C\uC0C1\uD6C8]\r"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[2].text
      value: "INSPIRED BY\r\n[\uC5FC\uB780\uC601]"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[3].text
      value: "CHARACTER\r\n[\uC5FC\uB780\uC601]"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[4].text
      value: "DEVELOPMENT\nGame Design & Programming\n\uC11C\uC0C1\uD6C8"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[5].text
      value: "Art & Graphics / Story & Narrative\n \uC11C\uC0C1\uD6C8"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[6].text
      value: "\uB780\uC601\uC774\uC5D0\uAC8C."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[7].text
      value: "\uC774 \uAC8C\uC784\uC744 \uB9CC\uB4E4\uBA74\uC11C \uB0B4\uB0B4\n\uB124
        \uC5BC\uAD74\uC744 \uC0DD\uAC01\uD588\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[8].text
      value: "\uC6C3\uB294 \uC5BC\uAD74,\n\uB180\uB77C\uB294 \uC5BC\uAD74,\n\uD22C\uB35C\uAC70\uB9AC\uB294
        \uC5BC\uAD74."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: letterSlides.Array.data[9].text
      value: "\uADF8 \uBAA8\uB4E0 \uD45C\uC815\uC774 \uB2E4 \uC88B\uC544\uC11C\n\uCD5C\uB300\uD55C
        \uB9CE\uC774 \uB2F4\uC73C\uB824\uACE0 \uD588\uC5B4."
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[0].text
      value: '[INTRO]'
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[1].text
      value: "\uC624\uB298\uB3C4 \uC6C3\uB294 \uB108\uC758 \uC5BC\uAD74 \uBE5B\uB098"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[2].text
      value: "\uC774 \uC791\uC740 \uC138\uC0C1\uC5D0 \uB098\uC758 \uBCC4\uC774 \uB3FC"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[3].text
      value: "\uC870\uC2EC\uD788 \uB9CC\uB4E0 \uC774 \uAC8C\uC784 \uC18D\uC5D0 \uB2F4\uC544"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[4].text
      value: "\uBAA8\uB4E0 \uB9C8\uC74C \uC804\uD574\uC904\uAC8C \uB0B4 \uC0AC\uB791"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[5].text
      value: "Every step every smile \uAE30\uC5B5\uD574"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[6].text
