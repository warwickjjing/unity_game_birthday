      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[7].text
      value: "\uB9D0\uC5C6\uC774\uB3C4 \uC804\uD574\uC9C0\uB294 \uB9C8\uC74C"
      objectReference: {fileID: 0}
    - target: {fileID: 6963688866856256175, guid: 908eb03c13abc9f43ba475a550e3eb28, type: 3}
      propertyPath: lyricsSlides.Array.data[8].text
      value: "You're always there \uB0B4 \uACC1\uC5D0"
