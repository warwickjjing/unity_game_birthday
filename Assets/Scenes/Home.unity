  butterSpawnPoint: {fileID: 0}
  butterPrefab: {fileID: 0}
  butterSpawnDelay: 5
  butterSpawnOffset: {x: 0, y: 0, z: 1.5}
  giveMilkDialogues:
  - text: "\uC790, \uBC1B\uC544!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1364516766, guid: 4d0297b35e11cc24fb22ce37c566eb88, type: 3}
    trigger: 0
    choices: []
  - text: "(\uC18C\uAC00 \uC6B0\uC720\uB97C \uBC1B\uC544\uC11C \uB0E0\uB0E0...)"
    speakerName: "\uC18C"
    speakerPortrait: {fileID: 0}
    trigger: 0
    choices: []
  - text: " ...\uC9C0\uAE08 \uBB58 \uAE30\uB2E4\uB9AC\uB294 \uAC70\uC9C0?"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 568604705, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
    trigger: 0
    choices: []
  butterSpawnDialogues:
  - text: "\uC5B4?! \uC9C4\uC9DC \uBC84\uD130\uAC00 \uB098\uC654\uC5B4!!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1861983472, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
    trigger: 0
    choices: []
  - text: "\uADF8\uB7FC!! \uC5ED\uC2DC \uC6B0\uB9AC \uC18C \uCD5C\uACE0\uC57C!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1861983472, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
    trigger: 0
    choices: []
  - text: "\uC544\uB2C8 \uC774 \uC138\uACC4\uAD00\uC774 \uB300\uCCB4 \uC5B4\uB5BB\uAC8C
      \uB3CC\uC544\uAC00\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB2E4."
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 568604705, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
    trigger: 0
    choices: []
  references:
    version: 2
    RefIds: []
