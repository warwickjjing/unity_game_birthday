--- !u!114 &1607025203
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1607025202}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c07983788f900404a9c69b7fccaf392d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  startDialogues:
  - text: "\uC800\uAE30... \uC8C4\uC1A1\uD55C\uB370 \uBC00\uAC00\uB8E8\uC880 \uC5BB\uC744
      \uC218 \uC788\uC744\uAE4C\uC694?"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 568604705, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  - text: "\uB124? \uAC11\uC790\uAE30 \uBC00\uAC00\uB8E8\uB97C\uC694?"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300014, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uC0C1\uD6C8\uC774\uAC00 \uB9D0\uD558\uBA74 \uC8FC\uC2E0\uB2E4\uACE0 \uD574\uC11C\uC694!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 568604705, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  - text: "\uC544\uC544~~ \uC8FC\uC778\uB2D8 \uBD80\uD0C1\uC774\uAD70\uC694! \uADF8\uB7FC
      \uB2F9\uC5F0\uD788 \uB4DC\uB824\uC57C\uC8E0!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300012, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uADFC\uB370 \uB9C8\uCE68 \uC81C\uAC00 \uBC00\uAC00\uB8E8\uB97C \uB2E4
      \uBABB \uC62E\uACBC\uB294\uB370... \uC800\uAE30 \uAE38 \uAC74\uB108\uC5D0 \uC788\uB294
      \uD3EC\uB300 5\uAC1C\uB9CC \uC62E\uACA8\uC8FC\uC2E4 \uC218 \uC788\uC5B4\uC694?"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300012, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uADF8\uB7FC \uC81C\uAC00 \uD558\uB098 \uB4DC\uB9B4\uAC8C\uC694!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300010, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "5\uAC1C\uC694? \uBB50 \uC5B4\uB835\uC9C0 \uC54A\uC8E0, \uAE08\uBC29 \uC62E\uACA8\uB4DC\uB9B4\uAC8C\uC694!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1861983472, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  progressDialogues: []
  completeDialogues:
  - text: "\uC5B4\uBA38, \uAE08\uBC29 \uC62E\uACA8\uC8FC\uC168\uB124\uC694! \uC815\uB9D0
      \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300012, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uBCC4\uAC70 \uC544\uB2CC\uAC78\uC694~ \uC5EC\uAE30 \uC624\uB294 \uAC83
      \uC790\uCCB4\uAC00 \uB354 \uD798\uB4E4\uC5C8\uC5B4\uC694."
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 552074894, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  - text: "\uD558\uD558, \uC5EC\uAE30 \uBC00\uAC00\uB8E8 \uB4DC\uB9B4\uAC8C\uC694!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300012, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uAC10\uC0AC\uD574\uC694! \uC774\uAC78\uB85C \uB9DB\uC788\uB294 \uCF00\uC774\uD06C
      \uB9CC\uB4E4 \uC218 \uC788\uACA0\uB2E4!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1861983472, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  - text: "\uC544, \uC8FC\uC778\uB2D8\uC774 \uADF8\uB807\uAC8C \uBC14\uC058\uAC8C
      \uC900\uBE44\uD558\uC2DC\uB354\uB2C8 \uC0AC\uBAA8\uB2D8 \uC0DD\uC77C\uC774\uC168\uAD70\uC694!
      \uCD95\uD558\uB4DC\uB824\uC694!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300010, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  - text: "\uC5B4\uBA38, \uAC10\uC0AC\uD574\uC694. \uADF8\uB7FC \uC800\uB294 \uB3CC\uC544\uAC08\uAC8C\uC694!"
    speakerName: "\uC5FC\uB780\uC601"
    speakerPortrait: {fileID: 1861983472, guid: dc29777644dc5774fae65d56290cc3a5, type: 3}
  - text: "\uC870\uC2EC\uD788 \uAC00\uC138\uC694~ \uB2E4\uC74C\uC5D0 \uB610 \uC624\uC138\uC694!"
    speakerName: "\uB18D\uC7A5\uC8FC\uC778"
    speakerPortrait: {fileID: 21300012, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
  dialogueUI: {fileID: 1590428056}
  sceneController: {fileID: 889575453}
  npcName: "\uB9C8\uC744 \uC8FC\uBBFC"
  npcPortrait: {fileID: 21300014, guid: d79edf18a76e2654a9ac99f15de8b2b3, type: 3}
